{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.1.0",
  "author": "Shikhar Srivastava",
  "homepage_url": "https://github.com/ItisShikhar/theatre-vision",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "theatre-vision@itisshikhar.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteActivity"]
      }
    }
  },

  "permissions": ["storage"],

  "icons": {
    "16": "assets/logo_compact_bg_16.png",
    "32": "assets/logo_compact_bg_32.png",
    "48": "assets/logo_compact_bg_48.png",
    "128": "assets/logo_compact_bg_128.png",
    "512": "assets/logo_compact_bg_512.png"
  },

  "host_permissions": ["<all_urls>"],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/domain-utils.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "assets/logo_compact_bg_16.png",
      "32": "assets/logo_compact_bg_32.png",
      "48": "assets/logo_compact_bg_48.png",
      "128": "assets/logo_compact_bg_128.png",
      "512": "assets/logo_compact_bg_512.png"
    },
    "default_popup": "src/popup.html"
  }
}
