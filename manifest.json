{
  "manifest_version": 3,
  "name": "Theatre Vision",
  "description": "Expand videos into a theatre view while keeping the site's native player and captions.",
  "version": "1.1.0",

  "permissions": ["storage"],

  "icons": {
    "16": "icons/theatre-vision-16.png",
    "32": "icons/theatre-vision-32.png",
    "48": "icons/theatre-vision-48.png",
    "128": "icons/theatre-vision-128.png"
  },

  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["domain-utils.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_page": "options.html",

  "action": {
    "default_title": "Theatre Vision",
    "default_icon": {
      "16": "icons/theatre-vision-16.png",
      "32": "icons/theatre-vision-32.png"
    },
    "default_popup": "popup.html"
  }
}
