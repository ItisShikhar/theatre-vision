{
  "manifest_version": 3,
  "name": "Theatre Vision",
  "description": "Expand videos into a theatre view while keeping the site's native player and captions.",
  "version": "1.1.0",
  "default_locale": "en",

  "permissions": ["storage"],

  "icons": {
    "16": "assets/logo_compact_bg_x512.png",
    "32": "assets/logo_compact_bg_x512.png",
    "48": "assets/logo_compact_bg_x512.png",
    "128": "assets/logo_compact_bg_x512.png"
  },

  "host_permissions": ["<all_urls>"],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/domain-utils.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_page": "src/options.html",

  "action": {
    "default_title": "Theatre Vision",
    "default_icon": {
      "16": "assets/logo_compact_bg_x512.png",
      "32": "assets/logo_compact_bg_x512.png"
    },
    "default_popup": "src/popup.html"
  }
}
